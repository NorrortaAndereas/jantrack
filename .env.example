# Sätts automatiskt av Neon-integrationen i Vercel.
# Lokalt: kör `vercel env pull .env.local --environment=production` eller klistra in din Neon-URL här.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Hemlig nyckel för inloggningen. Generera med: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Valfritt – sidans publika adress. Utan den används Vercels adress automatiskt.
# BETTER_AUTH_URL=https://jantrack.vercel.app

# Kommer senare, för AI-coachen:
# ANTHROPIC_API_KEY=
